# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Lingya / OpenAI-compatible Image API
# 文档默认 Base URL：https://api.lingyaai.cn
LINGYA_BASE_URL=https://api.lingyaai.cn
LINGYA_API_KEY=your-lingya-api-key
# LINGYA_TEXT_MODEL=gpt-4o-mini
LINGYA_VISION_MODEL=gpt-4o-mini
# 开启前置视觉提示词分析，用于生成更真实摄影质感的换装提示词。
NEXT_PUBLIC_ENABLE_PROMPT_ANALYSIS=true

# FASHN AI
FASHN_API_KEY=your-fashn-api-key

# Replicate (for face swap)
REPLICATE_API_TOKEN=your-replicate-token

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
