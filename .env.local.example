# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Lingya / OpenAI-compatible Image API
# 文档默认 Base URL：https://api.lingyaai.cn
LINGYA_BASE_URL=https://api.lingyaai.cn
LINGYA_API_KEY=your-lingya-api-key
# LINGYA_TEXT_MODEL=gpt-4o-mini
LINGYA_VISION_MODEL=gpt-4o-mini
# 开启前置视觉提示词分析，用于生成更真实摄影质感的换装提示词。
NEXT_PUBLIC_ENABLE_PROMPT_ANALYSIS=true

# 图片分析 / 提示词优化 LLM Provider
# 一键切换：xiaomi 使用小米 MiMo；lingya 使用原 Lingya/OpenAI-compatible 配置。
ANALYZE_LLM_PROVIDER=xiaomi
XIAOMI_MIMO_API_KEY=your-xiaomi-mimo-api-key
XIAOMI_MIMO_BASE_URL=https://api.xiaomimimo.com
# 如果你的 key 是 tp- 开头的 token-plan key，通常需要改为对应区域：
# XIAOMI_MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com
XIAOMI_MIMO_MODEL=mimo-v2.5-pro
# 图片分析需要多模态模型；文本提示词优化用 Pro。
XIAOMI_MIMO_TEXT_MODEL=mimo-v2.5-pro
XIAOMI_MIMO_VISION_MODEL=mimo-v2.5

# FASHN AI
FASHN_API_KEY=your-fashn-api-key

# Replicate (for face swap)
REPLICATE_API_TOKEN=your-replicate-token

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated extra hosts allowed by /api/download-image.
# DOWNLOAD_IMAGE_ALLOWED_HOSTS=example-cdn.com,*.example-storage.com

# ImgBB image upload (https://api.imgbb.com)
IMGBB_API_KEY=your-imgbb-api-key

# Durable generation job processor
# Use this as Bearer token for /api/jobs/process-generations.
JOB_PROCESSOR_SECRET=change-me
GENERATION_JOB_BATCH_SIZE=2
GENERATION_JOB_STALE_MINUTES=8
